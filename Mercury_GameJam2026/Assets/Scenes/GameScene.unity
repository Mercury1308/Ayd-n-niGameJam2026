  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Bir g\xFCn k\xFC\xE7\xFCk bir kasabada ilgin\xE7 bir yar\u0131\u015Fma
    d\xFCzenlenir: \u201CEn de\u011Ferli vazo\u201D yar\u0131\u015Fmas\u0131. Herkes
    en s\xFCsl\xFC, en parlak, en pahal\u0131 vazosunu getirir. Alt\u0131n kaplamal\u0131
    olanlar, ta\u015Flarla s\xFCslenmi\u015F olanlar\u2026 Hepsi g\xF6z kama\u015Ft\u0131r\u0131r.\n\nAma
    yar\u0131\u015Fmaya ya\u015Fl\u0131 bir adam da kat\u0131l\u0131r. Elinde \xE7ok
    sade, hatta biraz \xE7atlak bir vazo vard\u0131r. \u0130nsanlar onu g\xF6r\xFCnce
    hafif\xE7e g\xFCl\xFCmser. \u201CBunun ne \u015Fans\u0131 var ki?\u201D diye
    d\xFC\u015F\xFCn\xFCrler.\n\nS\u0131ra de\u011Ferlendirmeye geldi\u011Finde j\xFCri
    \xFCyeleri tek tek vazolara bakar. En sonunda ya\u015Fl\u0131 adam\u0131n vazosuna
    gelirler. Adam sakince vazoyu masaya koyar ve i\xE7ine su doldurur. Sonra cebinden
    k\xFC\xE7\xFCk, solmaya y\xFCz tutmu\u015F bir \xE7i\xE7ek \xE7\u0131kar\u0131p
    vazoya yerle\u015Ftirir.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9e07249c5d5d12b4c85bcc846e1cf578, type: 2}
