  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Eren panikledi. \xC7\u0131k\u0131\u015Fa do\u011Fru ko\u015Fmaya ba\u015Flad\u0131
    ama lunapark art\u0131k eskisi gibi de\u011Fildi. Yollar uzuyor, oyuncaklar yer
    de\u011Fi\u015Ftiriyordu. Sanki lunapark onu b\u0131rakmak istemiyordu.\nTam
    umudunu kaybetmek \xFCzereyken, uzakta kap\u0131y\u0131 g\xF6rd\xFC. Son g\xFCc\xFCyle
    ko\u015Ftu ve d\u0131\u015Far\u0131 atlad\u0131.\nArkas\u0131n\u0131 d\xF6nd\xFC\u011F\xFCnde\u2026
    lunapark yine sessizdi. I\u015F\u0131klar s\xF6nm\xFC\u015F, her \u015Fey eski
    haline d\xF6nm\xFC\u015Ft\xFC.\nAma Eren bir \u015Feyi fark etti.\nElinde bir
    bilet vard\u0131.\n\xDCzerinde \u015F\xF6yle yaz\u0131yordu:\n\u201CTekrar gelmeni
    bekliyoruz.\u201D\nO g\xFCnden sonra Eren bir daha oraya gitmedi\u2026 ama her
    gece, r\xFCyas\u0131nda o lunapark\u0131 g\xF6rmeye devam etti.\nVe bazen\u2026
    uzaktan gelen bir kahkaha duydu\u011Funu s\xF6yl\xFCyordu.elirler. Adam sakince
    vazoyu masaya koyar ve i\xE7ine su doldurur. Sonra cebinden k\xFC\xE7\xFCk, solmaya
    y\xFCz tutmu\u015F bir \xE7i\xE7ek \xE7\u0131kar\u0131p vazoya yerle\u015Ftirir.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9e07249c5d5d12b4c85bcc846e1cf578, type: 2}
  m_sharedMaterial: {fileID: 1089878030183511789, guid: 9e07249c5d5d12b4c85bcc846e1cf578, type: 2}
